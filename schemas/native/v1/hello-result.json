{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dijo-404/disktop/schemas/native/v1/hello-result.json",
  "title": "disktop-fs hello or probe completion",
  "description": "The only completion shape the current helper build can produce.",
  "type": "object",
  "allOf": [{ "$ref": "event.json" }],
  "properties": {
    "event": { "const": "complete" },
    "result": { "$ref": "common.json#/$defs/helloResult" }
  }
}
