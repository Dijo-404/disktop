{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dijo-404/disktop/schemas/native/v1/request.json",
  "title": "disktop-fs request",
  "description": "One JSON object per line on the helper's stdin. Node spawns the helper directly and never builds a shell string.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "requestId",
    "operation",
    "arguments"
  ],
  "properties": {
    "protocolVersion": {
      "$ref": "common.json#/$defs/protocolVersion"
    },
    "requestId": {
      "$ref": "common.json#/$defs/requestId"
    },
    "operation": {
      "type": "string",
      "enum": [
        "hello",
        "probe",
        "cancel",
        "scan",
        "query-index",
        "hash-candidates",
        "inspect",
        "trash",
        "restore",
        "erase",
        "copy-move",
        "compress",
        "dedup-hardlink",
        "empty-trash",
        "manager-begin",
        "manager-append",
        "manager-finish",
        "journal-reconcile"
      ]
    },
    "arguments": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "enum": [
              "hello",
              "probe"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/noArguments"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "cancel"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/cancelArguments"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "scan"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/scanArguments"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "erase"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "common.json#/$defs/mutationArguments"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "empty-trash"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/emptyTrashArguments"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "query-index"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/queryIndexArguments"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "journal-reconcile"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/journalArguments"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "trash"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/trashArguments"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "restore"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "arguments": {
            "$ref": "#/$defs/restoreArguments"
          }
        }
      }
    }
  ],
  "$defs": {
    "noArguments": {
      "type": "object",
      "additionalProperties": false
    },
    "cancelArguments": {
      "description": "Stops another in-flight request at a safe item boundary; the cancelled request still emits a final event.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancelRequestId"
      ],
      "properties": {
        "cancelRequestId": {
          "$ref": "common.json#/$defs/requestId"
        }
      }
    },
    "scanArguments": {
      "description": "Symlinks are never followed, so there is no option to enable it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roots",
        "crossFilesystems",
        "excludes",
        "accounting",
        "indexDirectory"
      ],
      "properties": {
        "roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "common.json#/$defs/pathBytes"
          }
        },
        "crossFilesystems": {
          "type": "boolean"
        },
        "excludes": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/pathBytes"
          }
        },
        "accounting": {
          "type": "string",
          "enum": [
            "allocated",
            "apparent"
          ]
        },
        "throttleBytesPerSecond": {
          "$ref": "common.json#/$defs/decimalInteger"
        },
        "maxDepth": {
          "$ref": "common.json#/$defs/decimalInteger"
        },
        "indexDirectory": {
          "description": "Where the helper keeps its bounded index. Node owns the location; the helper is not told to guess it from the environment.",
          "$ref": "common.json#/$defs/pathBytes"
        },
        "maxIndexBytes": {
          "description": "Byte budget for the whole index file. Older scans are dropped, oldest first, until the file fits.",
          "$ref": "common.json#/$defs/decimalInteger"
        },
        "keepScans": {
          "description": "How many scans the index retains, newest first, including this one.",
          "$ref": "common.json#/$defs/decimalInteger"
        }
      }
    },
    "emptyTrashArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "journalDirectory",
        "homeTrashDirectory",
        "trashDirectories"
      ],
      "properties": {
        "planId": {
          "$ref": "common.json#/$defs/planId"
        },
        "journalDirectory": {
          "$ref": "common.json#/$defs/pathBytes"
        },
        "homeTrashDirectory": {
          "description": "`$XDG_DATA_HOME/Trash`, so the helper can recognise this user's own Trash without taking Node's word for which directories it may empty.",
          "$ref": "common.json#/$defs/pathBytes"
        },
        "trashDirectories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.json#/$defs/pathBytes"
          }
        }
      },
      "description": "Emptying Trash. Each named directory must be the home Trash or one of the two per-mount locations the freedesktop specification defines, and must hold a `files` and an `info` directory. Shape alone is not enough: `files` beside `info` is a layout ordinary data uses, and a plan that named the wrong directory would empty it."
    },
    "queryIndexArguments": {
      "description": "One page of an existing scan index. The helper never returns the whole tree.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanId",
        "indexDirectory",
        "sort",
        "order",
        "limit"
      ],
      "properties": {
        "scanId": {
          "$ref": "common.json#/$defs/scanId"
        },
        "filter": {
          "$ref": "common.json#/$defs/entryFilter"
        },
        "sort": {
          "type": "string",
          "enum": [
            "allocated",
            "apparent",
            "modified",
            "name"
          ]
        },
        "order": {
          "type": "string",
          "enum": [
            "ascending",
            "descending"
          ]
        },
        "limit": {
          "$ref": "common.json#/$defs/decimalInteger"
        },
        "cursor": {
          "$ref": "common.json#/$defs/cursor"
        },
        "includeTypeTotals": {
          "type": "boolean"
        },
        "indexDirectory": {
          "$ref": "common.json#/$defs/pathBytes"
        },
        "includeOwnerTotals": {
          "type": "boolean"
        }
      }
    },
    "journalArguments": {
      "description": "Where Disktop keeps its durable action journal. Node owns the location for the same reason it owns the index directory: the XDG rules live in one place.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journalDirectory"
      ],
      "properties": {
        "journalDirectory": {
          "$ref": "common.json#/$defs/pathBytes"
        },
        "cursor": {
          "$ref": "common.json#/$defs/cursor"
        },
        "limit": {
          "$ref": "common.json#/$defs/decimalInteger"
        }
      }
    },
    "trashArguments": {
      "description": "A Trash move. `homeTrashDirectory` is `$XDG_DATA_HOME/Trash`; a target on another filesystem goes to that mount's own Trash instead, and refuses rather than falling back to removal.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "journalDirectory",
        "homeTrashDirectory",
        "targets"
      ],
      "properties": {
        "planId": {
          "$ref": "common.json#/$defs/planId"
        },
        "journalDirectory": {
          "$ref": "common.json#/$defs/pathBytes"
        },
        "homeTrashDirectory": {
          "$ref": "common.json#/$defs/pathBytes"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "$ref": "common.json#/$defs/mutationTarget"
          }
        }
      }
    },
    "restoreArguments": {
      "description": "Put back what one Trash action moved. The journal record is the authority for where each item went and where it came from; nothing is reconstructed from a path the caller supplied.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journalDirectory",
        "journalId"
      ],
      "properties": {
        "journalDirectory": {
          "$ref": "common.json#/$defs/pathBytes"
        },
        "journalId": {
          "$ref": "common.json#/$defs/planId"
        }
      }
    }
  }
}
