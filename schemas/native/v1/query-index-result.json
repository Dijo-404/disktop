{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dijo-404/disktop/schemas/native/v1/query-index-result.json",
  "title": "disktop-fs index page",
  "description": "One page of index rows for a finished or partial scan, with an optional continuation cursor.",
  "type": "object",
  "allOf": [{ "$ref": "event.json" }],
  "properties": {
    "event": { "const": "complete" },
    "result": { "$ref": "common.json#/$defs/queryIndexResult" }
  }
}
