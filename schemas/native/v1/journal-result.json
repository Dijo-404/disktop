{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dijo-404/disktop/schemas/native/v1/journal-result.json",
  "title": "disktop-fs journal-reconcile result",
  "description": "The terminal event of a `journal-reconcile` request.",
  "type": "object",
  "allOf": [
    {
      "$ref": "event.json"
    }
  ],
  "properties": {
    "event": {
      "const": "complete"
    },
    "result": {
      "$ref": "common.json#/$defs/journalResult"
    }
  }
}
