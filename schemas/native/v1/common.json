{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dijo-404/disktop/schemas/native/v1/common.json",
  "title": "disktop-fs protocol v1 shared definitions",
  "$defs": {
    "protocolVersion": {
      "const": 1
    },
    "requestId": {
      "description": "Client-chosen correlation ID. The restricted alphabet keeps it safe to echo into logs.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "eventId": {
      "description": "Monotonic per request, base-10, starting at 1.",
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "decimalInteger": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "pathBytes": {
      "description": "Raw path bytes as base64. The helper never resolves a target from a display string.",
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "planId": {
      "description": "Identifies the reviewed, stored plan this mutation was authorized by.",
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "entryFingerprint": {
      "description": "What the reviewed plan observed. The helper refuses an item whose live identity differs. Identity is the device, inode, kind, size, and modification time; `mountId` travels with them as context and is not compared, because the client cannot read the kernel's mount id and would be sending a number it invented.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "inode",
        "mountId",
        "kind",
        "apparentBytes",
        "modifiedNanoseconds"
      ],
      "properties": {
        "device": {
          "$ref": "#/$defs/decimalInteger"
        },
        "inode": {
          "$ref": "#/$defs/decimalInteger"
        },
        "mountId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "directory",
            "symlink"
          ]
        },
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "modifiedNanoseconds": {
          "$ref": "#/$defs/decimalInteger"
        }
      }
    },
    "mutationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "expected"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/pathBytes"
        },
        "expected": {
          "$ref": "#/$defs/entryFingerprint"
        },
        "reviewedBytes": {
          "description": "What the reviewed plan measured for this entry. The helper renames a subtree in one syscall rather than re-measuring it, so it reports this number back partitioned by what actually happened; it is the plan's figure, not a fresh reading.",
          "$ref": "#/$defs/decimalInteger"
        },
        "subtree": {
          "$ref": "#/$defs/subtree"
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "expected": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "directory"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "expected"
        ]
      },
      "then": {
        "properties": {
          "subtree": {
            "type": "object"
          }
        },
        "required": [
          "subtree"
        ]
      }
    },
    "subtree": {
      "description": "Every entry below a reviewed directory, digested: relative path bytes, kind, inode, size and modification time, children in byte order. A directory target must carry the one it was reviewed with; the helper digests it again before the directory is moved or removed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "digest"
      ],
      "properties": {
        "entries": {
          "$ref": "#/$defs/decimalInteger"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "mutationArguments": {
      "description": "Common shape of every request that changes a user file.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "journalDirectory",
        "targets"
      ],
      "properties": {
        "planId": {
          "$ref": "#/$defs/planId"
        },
        "journalDirectory": {
          "description": "Where Disktop keeps its durable action journal. Node owns the location for the same reason it owns the index directory: the XDG rules live in one place.",
          "$ref": "#/$defs/pathBytes"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/mutationTarget"
          }
        }
      }
    },
    "capabilityProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "reason"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scanId": {
      "description": "Identifies one finished or partial scan and the index rows it owns.",
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "cursor": {
      "description": "Opaque continuation token for a paginated index query.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "entryKind": {
      "type": "string",
      "enum": [
        "file",
        "directory",
        "symlink",
        "other"
      ]
    },
    "warningCode": {
      "description": "Why a result is partial, uncertain, or degraded. A scan never reports a missed subtree as zero bytes. `warnings-truncated` says how many further warnings of one code were counted but not listed, so the list cannot grow with the filesystem.",
      "type": "string",
      "enum": [
        "inaccessible-directory",
        "excluded-mount",
        "nested-mount",
        "crossed-filesystem-skipped",
        "changed-during-scan",
        "unsupported-filesystem",
        "symlink-not-followed",
        "depth-limit-reached",
        "cancelled",
        "warnings-truncated"
      ]
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/warningCode"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/pathBytes"
        }
      }
    },
    "indexedEntry": {
      "description": "One row of the helper's index. Sizes are lossless decimal strings; `shared` marks a hardlink whose bytes were attributed to another path.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "kind",
        "device",
        "inode",
        "mountId",
        "linkCount",
        "apparentBytes",
        "allocatedBytes",
        "ownerId",
        "modifiedNanoseconds",
        "shared"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/decimalInteger"
        },
        "parentId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "path": {
          "$ref": "#/$defs/pathBytes"
        },
        "kind": {
          "$ref": "#/$defs/entryKind"
        },
        "device": {
          "$ref": "#/$defs/decimalInteger"
        },
        "inode": {
          "$ref": "#/$defs/decimalInteger"
        },
        "mountId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "linkCount": {
          "$ref": "#/$defs/decimalInteger"
        },
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "allocatedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "ownerId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "modifiedNanoseconds": {
          "$ref": "#/$defs/decimalInteger"
        },
        "shared": {
          "type": "boolean"
        },
        "childEntries": {
          "description": "Names directly inside a directory the scan entered, excluding `.` and `..`. Absent for anything else, including a directory that could not be opened: nobody looking is not the same answer as nothing being there.",
          "$ref": "#/$defs/decimalInteger"
        },
        "broken": {
          "description": "True only for a symlink whose target does not resolve. Removing one frees the link, not what it pointed at.",
          "type": "boolean"
        }
      }
    },
    "typeTotal": {
      "description": "Aggregate for one lowercased extension; the empty string groups files with no extension.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension",
        "entries",
        "allocatedBytes",
        "apparentBytes"
      ],
      "properties": {
        "extension": {
          "type": "string",
          "maxLength": 64
        },
        "entries": {
          "$ref": "#/$defs/decimalInteger"
        },
        "allocatedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        }
      }
    },
    "entryFilter": {
      "description": "Every field is optional and narrows the page. Text matching uses the normalized searchable column, never the raw bytes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parentId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "nameContains": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "extension": {
          "type": "string",
          "maxLength": 64
        },
        "minAllocatedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "maxAllocatedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "modifiedBeforeNanoseconds": {
          "$ref": "#/$defs/decimalInteger"
        },
        "ownerId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/entryKind"
          }
        },
        "underPath": {
          "description": "Restrict the page to this path and everything below it. A path the scan never saw is refused rather than answered with an empty page.",
          "$ref": "#/$defs/pathBytes"
        },
        "maxChildEntries": {
          "description": "Keep only rows with at most this many direct children. A row with no count is left out, so an unreadable directory never answers a search for empty ones.",
          "$ref": "#/$defs/decimalInteger"
        },
        "broken": {
          "description": "Keep only broken symlinks, or only unbroken entries.",
          "type": "boolean"
        }
      }
    },
    "scanResult": {
      "description": "A scan's terminal completion. `complete: false` always carries at least one warning saying what was missed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanId",
        "complete",
        "roots",
        "accounting",
        "scannedEntries",
        "inaccessibleDirectories",
        "allocatedBytes",
        "apparentBytes",
        "sharedBytes",
        "excludedMounts",
        "warnings",
        "filesystems"
      ],
      "properties": {
        "scanId": {
          "$ref": "#/$defs/scanId"
        },
        "complete": {
          "type": "boolean"
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pathBytes"
          }
        },
        "accounting": {
          "type": "string",
          "enum": [
            "allocated",
            "apparent"
          ]
        },
        "scannedEntries": {
          "$ref": "#/$defs/decimalInteger"
        },
        "inaccessibleDirectories": {
          "$ref": "#/$defs/decimalInteger"
        },
        "allocatedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "sharedBytes": {
          "description": "Bytes reached through a second hardlink to an inode already counted, excluded from the totals above.",
          "$ref": "#/$defs/decimalInteger"
        },
        "excludedMounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathBytes"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        },
        "filesystems": {
          "description": "Device numbers the walk actually read. Derived from the roots alone it would miss every mount a crossFilesystems scan descended into, and two scans of different mounts would compare as if they measured the same thing.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/decimalInteger"
          }
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "complete": {
            "const": false
          }
        },
        "required": [
          "complete"
        ]
      },
      "then": {
        "properties": {
          "warnings": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "queryIndexResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanId",
        "entries"
      ],
      "properties": {
        "scanId": {
          "$ref": "#/$defs/scanId"
        },
        "entries": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/indexedEntry"
          }
        },
        "nextCursor": {
          "$ref": "#/$defs/cursor"
        },
        "typeTotals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typeTotal"
          }
        },
        "ownerTotals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ownerTotal"
          }
        }
      }
    },
    "helloResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "helperVersion",
        "buildChecksum",
        "platform",
        "architecture",
        "kernelCapabilities",
        "supportedOperations"
      ],
      "properties": {
        "helperVersion": {
          "type": "string",
          "minLength": 1
        },
        "buildChecksum": {
          "description": "Null for a development build. A release binary must carry a real checksum.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "platform": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "kernelCapabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "openat2"
          ],
          "properties": {
            "openat2": {
              "$ref": "#/$defs/capabilityProbe"
            }
          }
        },
        "supportedOperations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "invalid-request",
        "invalid-request-id",
        "invalid-arguments",
        "request-too-large",
        "unsupported-protocol-version",
        "unsupported-operation",
        "unknown-operation",
        "unknown-request",
        "protected-path",
        "changed-target",
        "unsafe-parent",
        "permission-denied",
        "unsupported-kernel",
        "unsupported-filesystem",
        "no-safe-trash",
        "expired-plan",
        "journal-write-failed",
        "cancelled",
        "internal-error"
      ]
    },
    "ownerTotal": {
      "description": "Bytes per owning user id over regular files only. Directory rows carry their whole subtree and a second hardlink carries bytes already attributed elsewhere, so including either would report more bytes than the filesystem holds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerId",
        "entries",
        "allocatedBytes",
        "apparentBytes"
      ],
      "properties": {
        "ownerId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "entries": {
          "$ref": "#/$defs/decimalInteger"
        },
        "allocatedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        }
      }
    },
    "actionState": {
      "description": "`uncertain` is what an interrupted action reads as until reconciliation can tell whether its last item happened. It is never promoted to `complete`.",
      "type": "string",
      "enum": [
        "in-progress",
        "complete",
        "partial",
        "uncertain"
      ]
    },
    "itemOutcome": {
      "type": "string",
      "enum": [
        "in-progress",
        "completed",
        "skipped",
        "failed",
        "uncertain"
      ]
    },
    "journalItem": {
      "description": "One reviewed item as the journal holds it. `destination` is where a move put it, which is what an undo reads to find the file again.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "path",
        "outcome",
        "bytes"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/decimalInteger"
        },
        "path": {
          "$ref": "#/$defs/pathBytes"
        },
        "destination": {
          "$ref": "#/$defs/pathBytes"
        },
        "outcome": {
          "$ref": "#/$defs/itemOutcome"
        },
        "message": {
          "type": "string"
        },
        "bytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "movedDevice": {
          "description": "The device of what was moved. A destination is a name, and a name is free again as soon as the file leaves Trash, so an undo compares this before it moves anything back.",
          "$ref": "#/$defs/decimalInteger"
        },
        "movedInode": {
          "$ref": "#/$defs/decimalInteger"
        }
      }
    },
    "journalRecord": {
      "description": "One action the helper performed. Times are unix milliseconds as decimal strings, like every other number here; the helper has no calendar and Node formats the public timestamp.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "planId",
        "operation",
        "startedAtMilliseconds",
        "state",
        "completed",
        "skipped",
        "failed",
        "selectedBytes",
        "bytesMovedToTrash",
        "items"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/planId"
        },
        "planId": {
          "$ref": "#/$defs/planId"
        },
        "operation": {
          "type": "string"
        },
        "startedAtMilliseconds": {
          "$ref": "#/$defs/decimalInteger"
        },
        "finishedAtMilliseconds": {
          "$ref": "#/$defs/decimalInteger"
        },
        "state": {
          "$ref": "#/$defs/actionState"
        },
        "completed": {
          "$ref": "#/$defs/decimalInteger"
        },
        "skipped": {
          "$ref": "#/$defs/decimalInteger"
        },
        "failed": {
          "$ref": "#/$defs/decimalInteger"
        },
        "selectedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "bytesMovedToTrash": {
          "description": "Bytes this action moved into Trash. On one filesystem that is usually not space anybody got back, which is why it is reported apart from the free-space readings.",
          "$ref": "#/$defs/decimalInteger"
        },
        "freeBytesBefore": {
          "$ref": "#/$defs/decimalInteger"
        },
        "freeBytesAfter": {
          "$ref": "#/$defs/decimalInteger"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/journalItem"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "complete",
                  "partial",
                  "uncertain"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "description": "A record that has been judged holds no item still claiming to be running.",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "outcome": {
                      "not": {
                        "const": "in-progress"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "journalResult": {
      "description": "A page of action history, after every record an interrupted run left behind has been resolved.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reconciled",
        "records"
      ],
      "properties": {
        "reconciled": {
          "description": "How many interrupted records this call resolved. Zero on a clean history.",
          "$ref": "#/$defs/decimalInteger"
        },
        "records": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/journalRecord"
          }
        },
        "nextCursor": {
          "$ref": "#/$defs/cursor"
        }
      }
    },
    "actionResult": {
      "description": "What one reviewed action did. Selected bytes, bytes moved to Trash, and the two free-space readings are separate values on purpose: a Trash move on one filesystem is a large number of bytes moved and no space reclaimed, and other processes change free space at the same time, so neither number may be presented as the other.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journalId",
        "state",
        "completed",
        "skipped",
        "failed",
        "selectedBytes",
        "bytesMovedToTrash",
        "undoAvailable"
      ],
      "properties": {
        "journalId": {
          "description": "The durable record this action wrote. A result without one is a protocol violation.",
          "$ref": "#/$defs/planId"
        },
        "state": {
          "$ref": "#/$defs/actionState"
        },
        "completed": {
          "$ref": "#/$defs/decimalInteger"
        },
        "skipped": {
          "$ref": "#/$defs/decimalInteger"
        },
        "failed": {
          "$ref": "#/$defs/decimalInteger"
        },
        "selectedBytes": {
          "description": "What the plan reviewed, over every target it named, whatever became of them.",
          "$ref": "#/$defs/decimalInteger"
        },
        "bytesMovedToTrash": {
          "description": "The reviewed size of the items that actually moved. Usually not space anybody got back until Trash is emptied.",
          "$ref": "#/$defs/decimalInteger"
        },
        "freeBytesBefore": {
          "description": "Space available on the filesystem holding the first target, read before the first item.",
          "$ref": "#/$defs/decimalInteger"
        },
        "freeBytesAfter": {
          "$ref": "#/$defs/decimalInteger"
        },
        "undoAvailable": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "state": {
                "const": "complete"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "description": "A complete action skipped nothing and failed nothing; anything else is partial.",
            "properties": {
              "skipped": {
                "const": "0"
              },
              "failed": {
                "const": "0"
              }
            }
          }
        }
      ]
    },
    "duplicateFile": {
      "description": "One file in a duplicate group, as the helper found it live rather than as the index remembered it. This is the identity a plan would fingerprint.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "device",
        "inode",
        "apparentBytes",
        "modifiedNanoseconds",
        "ownerId",
        "groupId",
        "permissions"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/pathBytes"
        },
        "device": {
          "$ref": "#/$defs/decimalInteger"
        },
        "inode": {
          "$ref": "#/$defs/decimalInteger"
        },
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "modifiedNanoseconds": {
          "$ref": "#/$defs/decimalInteger"
        },
        "ownerId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "groupId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "permissions": {
          "description": "Permission bits only, without the file-type bits the kind already carries.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        }
      }
    },
    "duplicateGroup": {
      "description": "Two or more files that hold the same bytes. A group of one is never reported, and two names reaching one inode are one member, because removing the second frees nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apparentBytes",
        "digest",
        "files"
      ],
      "properties": {
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "digest": {
          "description": "SHA-256 of the group's content, lowercase hexadecimal. It identifies a group within one result and is not a stable identifier across scans. It groups candidates; it never authorises a mutation, which re-reads both files and compares them byte for byte.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/duplicateFile"
          }
        }
      }
    },
    "duplicateResult": {
      "description": "Every group of identical files one search found. `complete` is false when a cap was reached, a file could not be read, or the search was cancelled, and a warning then says what was missed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groups",
        "complete",
        "warnings",
        "candidatesRead",
        "filesHashed"
      ],
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/duplicateGroup"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidatesRead": {
          "description": "Index rows that shared a size with at least one other file, so had to be considered.",
          "$ref": "#/$defs/decimalInteger"
        },
        "filesHashed": {
          "description": "Files whose content was actually read. Always no more than candidatesRead.",
          "$ref": "#/$defs/decimalInteger"
        }
      },
      "allOf": [
        {
          "description": "An incomplete answer says what it missed.",
          "if": {
            "properties": {
              "complete": {
                "const": false
              }
            },
            "required": [
              "complete"
            ]
          },
          "then": {
            "properties": {
              "warnings": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "inspectResult": {
      "description": "What is inside each directory asked about, or why it could not be read all the way down. A nested mount or an unreadable directory is a refusal, never a smaller digest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/pathBytes"
              },
              "subtree": {
                "$ref": "#/$defs/subtree"
              },
              "refusal": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "oneOf": [
              {
                "properties": {
                  "subtree": {
                    "type": "object"
                  }
                },
                "required": [
                  "subtree"
                ]
              },
              {
                "properties": {
                  "refusal": {
                    "type": "object"
                  }
                },
                "required": [
                  "refusal"
                ]
              }
            ]
          }
        }
      }
    }
  }
}
