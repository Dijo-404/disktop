{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dijo-404/disktop/schemas/native/v1/common.json",
  "title": "disktop-fs protocol v1 shared definitions",
  "$defs": {
    "protocolVersion": {
      "const": 1
    },
    "requestId": {
      "description": "Client-chosen correlation ID. The restricted alphabet keeps it safe to echo into logs.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "eventId": {
      "description": "Monotonic per request, base-10, starting at 1.",
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "decimalInteger": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "pathBytes": {
      "description": "Raw path bytes as base64. The helper never resolves a target from a display string.",
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "planId": {
      "description": "Identifies the reviewed, stored plan this mutation was authorized by.",
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "entryFingerprint": {
      "description": "What the reviewed plan observed. The helper refuses an item whose live identity differs.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "inode",
        "mountId",
        "kind",
        "apparentBytes",
        "modifiedNanoseconds"
      ],
      "properties": {
        "device": {
          "$ref": "#/$defs/decimalInteger"
        },
        "inode": {
          "$ref": "#/$defs/decimalInteger"
        },
        "mountId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "directory",
            "symlink"
          ]
        },
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "modifiedNanoseconds": {
          "$ref": "#/$defs/decimalInteger"
        }
      }
    },
    "mutationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "expected"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/pathBytes"
        },
        "expected": {
          "$ref": "#/$defs/entryFingerprint"
        }
      }
    },
    "mutationArguments": {
      "description": "Common shape of every request that changes a user file.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "targets"
      ],
      "properties": {
        "planId": {
          "$ref": "#/$defs/planId"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/mutationTarget"
          }
        }
      }
    },
    "capabilityProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "reason"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scanId": {
      "description": "Identifies one finished or partial scan and the index rows it owns.",
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "cursor": {
      "description": "Opaque continuation token for a paginated index query.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "entryKind": {
      "type": "string",
      "enum": [
        "file",
        "directory",
        "symlink",
        "other"
      ]
    },
    "warningCode": {
      "description": "Why a result is partial, uncertain, or degraded. A scan never reports a missed subtree as zero bytes. `warnings-truncated` says how many further warnings of one code were counted but not listed, so the list cannot grow with the filesystem.",
      "type": "string",
      "enum": [
        "inaccessible-directory",
        "excluded-mount",
        "nested-mount",
        "crossed-filesystem-skipped",
        "changed-during-scan",
        "unsupported-filesystem",
        "symlink-not-followed",
        "depth-limit-reached",
        "cancelled",
        "warnings-truncated"
      ]
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/warningCode"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/pathBytes"
        }
      }
    },
    "indexedEntry": {
      "description": "One row of the helper's index. Sizes are lossless decimal strings; `shared` marks a hardlink whose bytes were attributed to another path.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "kind",
        "device",
        "inode",
        "mountId",
        "linkCount",
        "apparentBytes",
        "allocatedBytes",
        "ownerId",
        "modifiedNanoseconds",
        "shared"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/decimalInteger"
        },
        "parentId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "path": {
          "$ref": "#/$defs/pathBytes"
        },
        "kind": {
          "$ref": "#/$defs/entryKind"
        },
        "device": {
          "$ref": "#/$defs/decimalInteger"
        },
        "inode": {
          "$ref": "#/$defs/decimalInteger"
        },
        "mountId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "linkCount": {
          "$ref": "#/$defs/decimalInteger"
        },
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "allocatedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "ownerId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "modifiedNanoseconds": {
          "$ref": "#/$defs/decimalInteger"
        },
        "shared": {
          "type": "boolean"
        }
      }
    },
    "typeTotal": {
      "description": "Aggregate for one lowercased extension; the empty string groups files with no extension.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension",
        "entries",
        "allocatedBytes",
        "apparentBytes"
      ],
      "properties": {
        "extension": {
          "type": "string",
          "maxLength": 64
        },
        "entries": {
          "$ref": "#/$defs/decimalInteger"
        },
        "allocatedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        }
      }
    },
    "entryFilter": {
      "description": "Every field is optional and narrows the page. Text matching uses the normalized searchable column, never the raw bytes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parentId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "nameContains": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "extension": {
          "type": "string",
          "maxLength": 64
        },
        "minAllocatedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "maxAllocatedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "modifiedBeforeNanoseconds": {
          "$ref": "#/$defs/decimalInteger"
        },
        "ownerId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/entryKind"
          }
        },
        "underPath": {
          "description": "Restrict the page to this path and everything below it. A path the scan never saw is refused rather than answered with an empty page.",
          "$ref": "#/$defs/pathBytes"
        }
      }
    },
    "scanResult": {
      "description": "A scan's terminal completion. `complete: false` always carries at least one warning saying what was missed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanId",
        "complete",
        "roots",
        "accounting",
        "scannedEntries",
        "inaccessibleDirectories",
        "allocatedBytes",
        "apparentBytes",
        "sharedBytes",
        "excludedMounts",
        "warnings",
        "filesystems"
      ],
      "properties": {
        "scanId": {
          "$ref": "#/$defs/scanId"
        },
        "complete": {
          "type": "boolean"
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pathBytes"
          }
        },
        "accounting": {
          "type": "string",
          "enum": [
            "allocated",
            "apparent"
          ]
        },
        "scannedEntries": {
          "$ref": "#/$defs/decimalInteger"
        },
        "inaccessibleDirectories": {
          "$ref": "#/$defs/decimalInteger"
        },
        "allocatedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "sharedBytes": {
          "description": "Bytes reached through a second hardlink to an inode already counted, excluded from the totals above.",
          "$ref": "#/$defs/decimalInteger"
        },
        "excludedMounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathBytes"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        },
        "filesystems": {
          "description": "Device numbers the walk actually read. Derived from the roots alone it would miss every mount a crossFilesystems scan descended into, and two scans of different mounts would compare as if they measured the same thing.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/decimalInteger"
          }
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "complete": {
            "const": false
          }
        },
        "required": [
          "complete"
        ]
      },
      "then": {
        "properties": {
          "warnings": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "queryIndexResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanId",
        "entries"
      ],
      "properties": {
        "scanId": {
          "$ref": "#/$defs/scanId"
        },
        "entries": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/indexedEntry"
          }
        },
        "nextCursor": {
          "$ref": "#/$defs/cursor"
        },
        "typeTotals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typeTotal"
          }
        },
        "ownerTotals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ownerTotal"
          }
        }
      }
    },
    "helloResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "helperVersion",
        "buildChecksum",
        "platform",
        "architecture",
        "kernelCapabilities",
        "supportedOperations"
      ],
      "properties": {
        "helperVersion": {
          "type": "string",
          "minLength": 1
        },
        "buildChecksum": {
          "description": "Null for a development build. A release binary must carry a real checksum.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "platform": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "kernelCapabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "openat2"
          ],
          "properties": {
            "openat2": {
              "$ref": "#/$defs/capabilityProbe"
            }
          }
        },
        "supportedOperations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "invalid-request",
        "invalid-request-id",
        "invalid-arguments",
        "request-too-large",
        "unsupported-protocol-version",
        "unsupported-operation",
        "unknown-operation",
        "unknown-request",
        "protected-path",
        "changed-target",
        "permission-denied",
        "unsupported-kernel",
        "unsupported-filesystem",
        "no-safe-trash",
        "journal-write-failed",
        "cancelled",
        "internal-error"
      ]
    },
    "ownerTotal": {
      "description": "Bytes per owning user id over regular files only. Directory rows carry their whole subtree and a second hardlink carries bytes already attributed elsewhere, so including either would report more bytes than the filesystem holds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerId",
        "entries",
        "allocatedBytes",
        "apparentBytes"
      ],
      "properties": {
        "ownerId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "entries": {
          "$ref": "#/$defs/decimalInteger"
        },
        "allocatedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        }
      }
    }
  }
}
