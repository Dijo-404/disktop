{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dijo-404/disktop/schemas/cli/v1/scan.json",
  "title": "disktop scan --json",
  "type": "object",
  "allOf": [
    {
      "$ref": "envelope.json"
    }
  ],
  "properties": {
    "command": {
      "const": "scan"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "scanId",
        "accounting",
        "roots",
        "totals",
        "completeness"
      ],
      "properties": {
        "capability": {
          "$ref": "common.json#/$defs/capability"
        },
        "scanId": {
          "$ref": "common.json#/$defs/identifier"
        },
        "snapshotId": {
          "description": "Absent when the scan could not be stored as a snapshot.",
          "$ref": "common.json#/$defs/identifier"
        },
        "accounting": {
          "type": "string",
          "enum": [
            "allocated",
            "apparent"
          ]
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.json#/$defs/rawPath"
          }
        },
        "totals": {
          "$ref": "common.json#/$defs/scanTotals"
        },
        "completeness": {
          "$ref": "common.json#/$defs/completeness"
        },
        "prunedSnapshots": {
          "$ref": "common.json#/$defs/decimalInteger"
        }
      }
    }
  }
}
