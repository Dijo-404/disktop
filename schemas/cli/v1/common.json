{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dijo-404/disktop/schemas/cli/v1/common.json",
  "title": "Disktop CLI v1 shared definitions",
  "$defs": {
    "decimalInteger": {
      "description": "A non-negative integer as a base-10 string, so no value is rounded by an IEEE 754 double.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "signedDecimalInteger": {
      "description": "A possibly negative integer as a base-10 string, used for observed free-space deltas.",
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": {
      "description": "UTC instant with millisecond precision.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "rawPath": {
      "description": "A Linux path. `bytesBase64` is the only lossless form; `display` is sanitized for terminals, HTML, and CSV and must never be used to resolve a target.",
      "type": "object",
      "additionalProperties": false,
      "required": ["bytesBase64", "display"],
      "properties": {
        "bytesBase64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "display": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
        },
        "utf8": { "type": "string" }
      }
    },
    "capabilityStatus": {
      "type": "string",
      "enum": [
        "available",
        "missing-tool",
        "permission-denied",
        "unsupported-kernel",
        "unsupported-filesystem",
        "unsupported-architecture"
      ]
    },
    "capability": {
      "description": "Absent data is never reported as zero; it carries the reason it is absent.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "explanation"],
      "properties": {
        "status": { "$ref": "#/$defs/capabilityStatus" },
        "explanation": { "type": "string" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "message": { "type": "string" },
        "path": { "$ref": "#/$defs/rawPath" }
      }
    },
    "failureCode": {
      "type": "string",
      "enum": [
        "permission-denied",
        "unsupported",
        "changed-target",
        "protected-path",
        "incomplete-scan",
        "cancelled",
        "invalid-plan",
        "invalid-input",
        "not-implemented",
        "internal-error"
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/failureCode" },
        "message": { "type": "string" },
        "details": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "completeness": {
      "description": "Every scan-shaped result states what it could not inspect.",
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "scannedEntries", "inaccessibleDirectories", "excludedMounts"],
      "properties": {
        "complete": { "type": "boolean" },
        "scannedEntries": { "$ref": "#/$defs/decimalInteger" },
        "inaccessibleDirectories": { "$ref": "#/$defs/decimalInteger" },
        "excludedMounts": {
          "type": "array",
          "items": { "$ref": "#/$defs/rawPath" }
        }
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "source",
        "mounts",
        "totalBytes",
        "freeBytes",
        "availableBytes",
        "network",
        "removable"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "type": "string" },
        "source": { "type": "string" },
        "mounts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rawPath" }
        },
        "totalBytes": { "$ref": "#/$defs/decimalInteger" },
        "freeBytes": { "$ref": "#/$defs/decimalInteger" },
        "availableBytes": { "$ref": "#/$defs/decimalInteger" },
        "totalInodes": { "$ref": "#/$defs/decimalInteger" },
        "freeInodes": { "$ref": "#/$defs/decimalInteger" },
        "network": { "type": "boolean" },
        "removable": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "deviceId": { "$ref": "#/$defs/identifier" }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "removable", "sizeBytes", "partitions"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string" },
        "kind": {
          "description": "`unknown` is reported when rotation data is absent; it is never guessed.",
          "type": "string",
          "enum": ["ssd", "hdd", "unknown"]
        },
        "removable": { "type": "boolean" },
        "sizeBytes": { "$ref": "#/$defs/decimalInteger" },
        "model": { "type": "string" },
        "transport": { "type": "string" },
        "partitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystemId", "kind", "usedPercent", "thresholdPercent", "message"],
      "properties": {
        "filesystemId": { "$ref": "#/$defs/identifier" },
        "kind": {
          "type": "string",
          "enum": ["low-space", "low-inodes"]
        },
        "usedPercent": { "$ref": "#/$defs/percent" },
        "thresholdPercent": { "$ref": "#/$defs/percent" },
        "message": { "type": "string" }
      }
    }
  }
}
