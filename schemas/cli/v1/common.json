{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dijo-404/disktop/schemas/cli/v1/common.json",
  "title": "Disktop CLI v1 shared definitions",
  "$defs": {
    "decimalInteger": {
      "description": "A non-negative integer as a base-10 string, so no value is rounded by an IEEE 754 double.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "signedDecimalInteger": {
      "description": "A possibly negative integer as a base-10 string, used for observed free-space deltas.",
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": {
      "description": "UTC instant with millisecond precision.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "rawPath": {
      "description": "A Linux path. `bytesBase64` is the only lossless form and the only value an operation may resolve. `display` is sanitized for terminals, HTML, and CSV: it carries no character that can command a terminal or reorder what follows it. Sanitizing makes the text safe to print, not unique.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytesBase64",
        "display"
      ],
      "properties": {
        "bytesBase64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "display": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u2028-\\u202E\\u2066-\\u2069]*$"
        },
        "utf8": {
          "type": "string"
        }
      }
    },
    "capabilityStatus": {
      "type": "string",
      "enum": [
        "available",
        "missing-tool",
        "permission-denied",
        "unsupported-kernel",
        "unsupported-filesystem",
        "unsupported-architecture"
      ]
    },
    "capability": {
      "description": "Absent data is never reported as zero; it carries the reason it is absent.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "explanation"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/capabilityStatus"
        },
        "explanation": {
          "type": "string"
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/identifier"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/rawPath"
        }
      }
    },
    "failureCode": {
      "type": "string",
      "enum": [
        "permission-denied",
        "unsupported",
        "changed-target",
        "protected-path",
        "incomplete-scan",
        "cancelled",
        "invalid-plan",
        "invalid-input",
        "not-implemented",
        "internal-error"
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/failureCode"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "completeness": {
      "description": "Every scan-shaped result states what it could not inspect.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "scannedEntries",
        "inaccessibleDirectories",
        "excludedMounts"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "scannedEntries": {
          "$ref": "#/$defs/decimalInteger"
        },
        "inaccessibleDirectories": {
          "$ref": "#/$defs/decimalInteger"
        },
        "excludedMounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rawPath"
          }
        }
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "source",
        "mounts",
        "totalBytes",
        "freeBytes",
        "availableBytes",
        "network",
        "removable"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "mounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rawPath"
          }
        },
        "totalBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "freeBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "availableBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "totalInodes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "freeInodes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "network": {
          "type": "boolean"
        },
        "removable": {
          "type": "boolean"
        },
        "readOnly": {
          "type": "boolean"
        },
        "deviceId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "removable",
        "sizeBytes",
        "partitions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "description": "`unknown` is reported when rotation data is absent; it is never guessed.",
          "type": "string",
          "enum": [
            "ssd",
            "hdd",
            "unknown"
          ]
        },
        "removable": {
          "type": "boolean"
        },
        "sizeBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "model": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        },
        "partitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystemId",
        "kind",
        "usedPercent",
        "thresholdPercent",
        "message"
      ],
      "properties": {
        "filesystemId": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "low-space",
            "low-inodes"
          ]
        },
        "usedPercent": {
          "$ref": "#/$defs/percent"
        },
        "thresholdPercent": {
          "$ref": "#/$defs/percent"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "entryKind": {
      "type": "string",
      "enum": [
        "file",
        "directory",
        "symlink",
        "other"
      ]
    },
    "indexedEntry": {
      "description": "One row of a scan index. A directory row carries the totals for its whole subtree; a file row carries its own. `shared` marks a hardlink whose bytes were attributed to an earlier path, so removing it frees nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "kind",
        "device",
        "inode",
        "mountId",
        "linkCount",
        "apparentBytes",
        "allocatedBytes",
        "ownerId",
        "modifiedNanoseconds",
        "shared"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/decimalInteger"
        },
        "parentId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "path": {
          "$ref": "#/$defs/rawPath"
        },
        "kind": {
          "$ref": "#/$defs/entryKind"
        },
        "device": {
          "$ref": "#/$defs/decimalInteger"
        },
        "inode": {
          "$ref": "#/$defs/decimalInteger"
        },
        "mountId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "linkCount": {
          "$ref": "#/$defs/decimalInteger"
        },
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "allocatedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "ownerId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "modifiedNanoseconds": {
          "$ref": "#/$defs/decimalInteger"
        },
        "shared": {
          "type": "boolean"
        },
        "childEntries": {
          "description": "Names directly inside a directory the scan entered, excluding `.` and `..`. Absent for anything else, including a directory that could not be opened: nobody looking is not the same answer as nothing being there.",
          "$ref": "#/$defs/decimalInteger"
        },
        "broken": {
          "description": "True only for a symlink whose target does not resolve. Removing one frees the link, not what it pointed at.",
          "type": "boolean"
        }
      }
    },
    "typeTotal": {
      "description": "Bytes per lowercased extension over regular files only; the empty string groups files with no extension. Directory rows and shared hardlinks are left out so the totals cannot exceed what the filesystem holds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension",
        "entries",
        "allocatedBytes",
        "apparentBytes"
      ],
      "properties": {
        "extension": {
          "type": "string",
          "maxLength": 64
        },
        "entries": {
          "$ref": "#/$defs/decimalInteger"
        },
        "allocatedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        }
      }
    },
    "scanTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocatedBytes",
        "apparentBytes",
        "sharedBytes"
      ],
      "properties": {
        "allocatedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "sharedBytes": {
          "description": "Bytes reached through a second hardlink to an inode already counted. Reported separately, never added to the totals.",
          "$ref": "#/$defs/decimalInteger"
        }
      }
    },
    "snapshotScope": {
      "description": "The rules a scan ran under. Two snapshots are comparable only when every field matches.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roots",
        "excludes",
        "accounting",
        "crossFilesystems",
        "filesystems"
      ],
      "properties": {
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rawPath"
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rawPath"
          }
        },
        "accounting": {
          "type": "string",
          "enum": [
            "allocated",
            "apparent"
          ]
        },
        "crossFilesystems": {
          "type": "boolean"
        },
        "filesystems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "maxDepth": {
          "description": "The depth the scan stopped at, when it was limited. A depth-limited scan of an unchanged tree otherwise diffs as a large deletion.",
          "$ref": "#/$defs/decimalInteger"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scanId",
        "scannedAt",
        "scope",
        "totals",
        "completeness"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "scanId": {
          "$ref": "#/$defs/identifier"
        },
        "scannedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "scope": {
          "$ref": "#/$defs/snapshotScope"
        },
        "totals": {
          "$ref": "#/$defs/scanTotals"
        },
        "completeness": {
          "$ref": "#/$defs/completeness"
        },
        "directories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/directorySummary"
          }
        }
      }
    },
    "directorySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "allocatedBytes",
        "apparentBytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/rawPath"
        },
        "allocatedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        }
      }
    },
    "directoryChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "earlierBytes",
        "laterBytes",
        "deltaBytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/rawPath"
        },
        "kind": {
          "description": "`added` and `removed` also describe a rename, or a directory that moved in or out of the snapshot top entries.",
          "type": "string",
          "enum": [
            "grew",
            "shrank",
            "added",
            "removed",
            "unchanged"
          ]
        },
        "earlierBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "laterBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "deltaBytes": {
          "$ref": "#/$defs/signedDecimalInteger"
        }
      }
    },
    "findingCategory": {
      "type": "string",
      "enum": [
        "dev-environment",
        "project-artifact",
        "language-cache",
        "ai-cache",
        "ide-cache",
        "browser-cache",
        "app-cache",
        "game-data",
        "vm-image",
        "system-snapshot",
        "installed-app",
        "log",
        "crash-dump",
        "swap",
        "temporary",
        "diagnostic",
        "per-user-usage"
      ]
    },
    "sizeBasis": {
      "description": "Where a byte count came from. There is no basis meaning `zero because nobody looked`: an unmeasured footprint is `unknown` and carries no number.",
      "type": "string",
      "enum": [
        "measured-allocated",
        "measured-apparent",
        "manager-reported",
        "stat",
        "unknown"
      ]
    },
    "findingSize": {
      "description": "A labelled byte count. `explanation` says what the number covers and what it leaves out.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "explanation"
      ],
      "properties": {
        "bytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "basis": {
          "$ref": "#/$defs/sizeBasis"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "basis": {
                "const": "unknown"
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "description": "An unknown size carries no number.",
            "properties": {
              "bytes": false
            }
          },
          "else": {
            "description": "Every other basis names the number it measured.",
            "required": [
              "bytes"
            ]
          }
        }
      ]
    },
    "findingConfidence": {
      "type": "string",
      "enum": [
        "observed",
        "likely",
        "uncertain"
      ]
    },
    "actionOperation": {
      "description": "An operation a plan can fix. `empty-trash` releases everything in this user's Trash and is irreversible; it can name no other directory.",
      "type": "string",
      "enum": [
        "trash",
        "permanent",
        "empty-trash",
        "move",
        "compress",
        "dedup-hardlink",
        "manager"
      ]
    },
    "finding": {
      "description": "One thing a provider noticed. A finding is a suggestion: it names the bytes it is about, where its number came from, and which operations could be offered, and it carries none of them out.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "providerId",
        "providerVersion",
        "category",
        "title",
        "evidence",
        "paths",
        "size",
        "confidence",
        "capability",
        "availableActionIds",
        "active"
      ],
      "properties": {
        "id": {
          "description": "`<providerId>:<slug>`, stable across releases.",
          "$ref": "#/$defs/identifier"
        },
        "providerId": {
          "$ref": "#/$defs/identifier"
        },
        "providerVersion": {
          "type": "integer",
          "minimum": 1
        },
        "category": {
          "$ref": "#/$defs/findingCategory"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "description": "The bytes this finding is about. Empty when the scope belongs to a manager.",
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/rawPath"
          }
        },
        "managerScope": {
          "description": "A bounded manager selection, never a shell line.",
          "type": "string",
          "maxLength": 512
        },
        "size": {
          "$ref": "#/$defs/findingSize"
        },
        "confidence": {
          "$ref": "#/$defs/findingConfidence"
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "availableActionIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionOperation"
          }
        },
        "regenerationCost": {
          "type": "string"
        },
        "active": {
          "description": "True when the data is in use: a browser profile, a model store, a running image.",
          "type": "boolean"
        }
      }
    },
    "providerReport": {
      "description": "One detector's outcome. A detector that could not look is listed with its reason, never omitted, so an absent detector is never read as an empty disk. `ran` is false when it never answered: it was absent, it was denied, or it threw.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "version",
        "capability",
        "findings",
        "complete",
        "ran"
      ],
      "properties": {
        "providerId": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        },
        "ran": {
          "type": "boolean"
        }
      }
    },
    "categoryTotal": {
      "description": "Bytes per category over measured findings that are not inside another finding. `unmeasured` is how many contributed nothing because nothing measured them; `nested` is how many sit inside another finding, so their bytes are already counted in it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "findings",
        "bytes",
        "unmeasured",
        "nested"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/findingCategory"
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "unmeasured": {
          "type": "integer",
          "minimum": 0
        },
        "nested": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "entryFingerprint": {
      "description": "What the plan observed about one entry. The helper refuses an item whose live identity differs, which is how a plan reviewed against one inode cannot be applied to another.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "inode",
        "mountId",
        "kind",
        "apparentBytes",
        "modifiedNanoseconds"
      ],
      "properties": {
        "device": {
          "$ref": "#/$defs/decimalInteger"
        },
        "inode": {
          "$ref": "#/$defs/decimalInteger"
        },
        "mountId": {
          "$ref": "#/$defs/decimalInteger"
        },
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "directory",
            "symlink"
          ]
        },
        "apparentBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "modifiedNanoseconds": {
          "$ref": "#/$defs/decimalInteger"
        }
      }
    },
    "plannedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "expected",
        "reviewedBytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/rawPath"
        },
        "expected": {
          "$ref": "#/$defs/entryFingerprint"
        },
        "reviewedBytes": {
          "description": "Blocks this entry occupied when the plan was made. The result reports this number back, partitioned by what became of the entry.",
          "$ref": "#/$defs/decimalInteger"
        }
      }
    },
    "actionPlan": {
      "description": "A reviewed, expiring, immutable action. The operation is fixed here and cannot change at apply time: `--permanent` acknowledges a plan that is already irreversible and never turns a Trash plan into one.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "createdAt",
        "expiresAt",
        "providerId",
        "scopeSummary",
        "reversibility",
        "permission",
        "selectedBytes",
        "warnings"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "operation": {
          "$ref": "#/$defs/actionOperation"
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "expiresAt": {
          "description": "After this the plan describes a filesystem that may have moved on, and applying it is refused rather than retried against whatever is there now.",
          "$ref": "#/$defs/timestamp"
        },
        "providerId": {
          "$ref": "#/$defs/identifier"
        },
        "findingId": {
          "$ref": "#/$defs/identifier"
        },
        "scopeSummary": {
          "type": "string",
          "minLength": 1
        },
        "reversibility": {
          "type": "string",
          "enum": [
            "undo-from-trash",
            "irreversible"
          ]
        },
        "permission": {
          "type": "string",
          "enum": [
            "user",
            "manager-privilege"
          ]
        },
        "exactItemCount": {
          "description": "Absent for a manager plan, which cannot promise a count before it runs.",
          "$ref": "#/$defs/decimalInteger"
        },
        "selectedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "entries": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/plannedEntry"
          }
        },
        "managerScope": {
          "type": "string",
          "maxLength": 512
        },
        "regenerationCost": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "reversibility": {
                "const": "irreversible"
              }
            },
            "required": [
              "reversibility"
            ]
          },
          "then": {
            "description": "An irreversible plan always carries at least the warning that says so.",
            "properties": {
              "warnings": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "actionItemOutcome": {
      "type": "string",
      "enum": [
        "in-progress",
        "completed",
        "skipped",
        "failed",
        "uncertain"
      ]
    },
    "actionState": {
      "description": "`uncertain` is what an interrupted action reads as once reconciliation could not tell whether its last item happened. It is never promoted to `complete`.",
      "type": "string",
      "enum": [
        "in-progress",
        "complete",
        "partial",
        "uncertain"
      ]
    },
    "actionResult": {
      "description": "What one action did. Selected bytes, bytes moved to Trash, and the observed free-space change are three separate numbers: a Trash move on one filesystem is a large number of bytes moved and no space reclaimed, and other processes change free space at the same time.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "journalId",
        "state",
        "completed",
        "skipped",
        "failed",
        "selectedBytes",
        "bytesMovedToTrash",
        "undoAvailable"
      ],
      "properties": {
        "planId": {
          "$ref": "#/$defs/identifier"
        },
        "journalId": {
          "description": "The durable record behind this result. A result without one is a protocol violation.",
          "$ref": "#/$defs/identifier"
        },
        "state": {
          "$ref": "#/$defs/actionState"
        },
        "completed": {
          "$ref": "#/$defs/decimalInteger"
        },
        "skipped": {
          "$ref": "#/$defs/decimalInteger"
        },
        "failed": {
          "$ref": "#/$defs/decimalInteger"
        },
        "selectedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "bytesMovedToTrash": {
          "$ref": "#/$defs/decimalInteger"
        },
        "freeBytesBefore": {
          "$ref": "#/$defs/decimalInteger"
        },
        "freeBytesAfter": {
          "$ref": "#/$defs/decimalInteger"
        },
        "observedFreeSpaceChange": {
          "description": "Free space after minus free space before. Absent when either reading failed: nothing changed and nobody could tell are different answers.",
          "$ref": "#/$defs/signedDecimalInteger"
        },
        "undoAvailable": {
          "type": "boolean"
        },
        "notes": {
          "description": "What the numbers above do and do not mean on this filesystem.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "journalItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "outcome",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/rawPath"
        },
        "destination": {
          "description": "Where a move put it. This is what an undo reads to find the file again.",
          "$ref": "#/$defs/rawPath"
        },
        "outcome": {
          "$ref": "#/$defs/actionItemOutcome"
        },
        "message": {
          "type": "string"
        },
        "bytes": {
          "$ref": "#/$defs/decimalInteger"
        }
      }
    },
    "journalRecord": {
      "description": "One action the helper performed, as the durable journal holds it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "planId",
        "operation",
        "startedAt",
        "state",
        "completed",
        "skipped",
        "failed",
        "selectedBytes",
        "bytesMovedToTrash",
        "items"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "planId": {
          "$ref": "#/$defs/identifier"
        },
        "operation": {
          "type": "string"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "finishedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "state": {
          "$ref": "#/$defs/actionState"
        },
        "completed": {
          "$ref": "#/$defs/decimalInteger"
        },
        "skipped": {
          "$ref": "#/$defs/decimalInteger"
        },
        "failed": {
          "$ref": "#/$defs/decimalInteger"
        },
        "selectedBytes": {
          "$ref": "#/$defs/decimalInteger"
        },
        "bytesMovedToTrash": {
          "$ref": "#/$defs/decimalInteger"
        },
        "freeBytesBefore": {
          "$ref": "#/$defs/decimalInteger"
        },
        "freeBytesAfter": {
          "$ref": "#/$defs/decimalInteger"
        },
        "undoAvailable": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/journalItem"
          }
        }
      }
    }
  }
}
