{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dijo-404/disktop/schemas/cli/v1/error.json",
  "title": "Failed --json command",
  "description": "A command that cannot produce its payload still emits a schema-compatible envelope. It exits 2, or 130 when an interrupt stopped it before it had a result, which is then what its failure code says.",
  "type": "object",
  "allOf": [
    { "$ref": "envelope.json" },
    {
      "if": {
        "type": "object",
        "properties": { "exitCode": { "const": 130 } },
        "required": ["exitCode"]
      },
      "then": {
        "properties": {
          "error": {
            "type": "object",
            "properties": { "code": { "const": "cancelled" } },
            "required": ["code"]
          }
        }
      }
    }
  ],
  "properties": {
    "status": { "const": "error" },
    "exitCode": { "enum": [2, 130] }
  }
}
