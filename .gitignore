# JavaScript and TypeScript dependencies and generated output
/node_modules
/dist/
/coverage/
/*.tsbuildinfo
*.tsbuildinfo
/.nyc_output/
/test-results/
/playwright-report/

# Rust output. Keep Cargo.lock tracked for the executable.
/target/
/native/disktop-fs/target/

# Bundled native binaries are generated by the release build.
/vendor/bin/*
!/vendor/bin/README.md

# Local scan data, reports, package archives, and demo recordings
/.cache/
/.tmp/
/tmp/
/reports-generated/
/recordings/
/*.tgz
/*.tar.gz

# Local secrets and credentials
.env
.env.*
!.env.example
!.env.*.example
.npmrc

# Tool logs and editor files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Superpowers execution scratch
/.superpowers/

# Claude Code agent worktrees and local settings
/.claude/worktrees/
/.claude/settings.local.json

# Release helper and tarball artifacts that CI downloads into the workspace
/.release-helpers/
/.release/
